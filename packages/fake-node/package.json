{
  "name": "@gasboost/fake-node",
  "version": "0.1.0",
  "description": "This package provides a fake implementation of Google Apps Script built-in services for testing purposes.",
  "license": "MIT",
  "author": "tiger-oshima",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gasboost/fake.git",
    "directory": "packages/fake-node"
  },
  "type": "module",
  "scripts": {
    "format": "prettier --ignore-path ../../.prettierignore --write .",
    "formatcheck": "prettier --ignore-path ../../.prettierignore --check .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --ext .ts",
    "test": "vitest run",
    "check": "pnpm formatcheck && pnpm lint && pnpm typecheck && pnpm test",
    "build": "rm -rf dist && tsc -p tsconfig.json"
  },
  "dependencies": {
    "date-fns-tz": "^3.2.0",
    "fflate": "^0.8.3",
    "@gasboost/fake-core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.4.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  }
}
