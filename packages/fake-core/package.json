{
  "name": "@gasboost/fake-core",
  "version": "0.0.0",
  "description": "This package provides a fake implementation of Google Apps Script built-in services for testing purposes.",
  "license": "MIT",
  "author": "tiger-oshima",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gasboost/fake.git",
    "directory": "packages/fake-core"
  },
  "type": "module",
  "scripts": {
    "format": "prettier --ignore-path ../../.prettierignore --write .",
    "formatcheck": "prettier --ignore-path ../../.prettierignore --check .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --ext .ts",
    "test": "vitest run",
    "check": "pnpm formatcheck && pnpm lint && pnpm typecheck && pnpm test",
    "build": "tsc -p tsconfig.json"
  },
  "exports": {
    ".": "./dist/index.js",
    "./internal": "./dist/internal.js"
  }
}
